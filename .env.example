# Kashe - ortam degiskenleri ornegi (degerler BOS; gercek degerler .env.local'da
# ve Vercel ortam degiskenlerinde durur, depoya GIRMEZ).

# Supabase (public: tarayiciya da gider)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site adresi (e-posta ve portal baglantilari; onizlemede dal adresi)
NEXT_PUBLIC_SITE_URL=

# E-posta gonderimi
RESEND_API_KEY=
EMAIL_FROM=

# Web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Kashe AI (model cagrilari)
ANTHROPIC_API_KEY=

# Girissiz Kashe AI hakki (Duzeltme 06): sunucu tarafi ortak anahtar.
# Veritabaninda yalniz SHA-256 ozeti durur; bos ya da yanlis deger =
# girissiz kullanim KAPALI (hak verilmez).
AI_GIRISSIZ_ANAHTAR=

# Bakim modu
NEXT_PUBLIC_BAKIM_MODU=
BAKIM_ANAHTARI=
